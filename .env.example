# ============================================
# Variáveis de ambiente — Sistema de Faturas
# ============================================
# Copie este arquivo para .env.local (desenvolvimento)
# ou configure no painel da Vercel (produção)

# ----- Banco de dados -----
# Desenvolvimento (Docker local):
# DATABASE_URL="postgresql://postgres:senha123@127.0.0.1:5432/sistema_faturas"
#
# Produção (Neon, Supabase, Vercel Postgres, etc):
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/sistema_faturas?sslmode=require"

# ----- NextAuth.js v5 -----
# Gere um secret seguro com: openssl rand -base64 32
# Ou online: https://generate-secret.vercel.app/32
AUTH_SECRET="seu-secret-de-32-caracteres-aqui"
NEXTAUTH_SECRET="seu-secret-de-32-caracteres-aqui"

# URL pública da aplicação
# Desenvolvimento: http://localhost:3000
# Produção: https://seu-dominio.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ----- E-mail (Resend) - opcional -----
# Para recuperação de senha (não implementado nesta versão)
RESEND_API_KEY="re_test_key_change_later"
EMAIL_FROM="noreply@seu-dominio.com.br"

# ----- Ambiente -----
NODE_ENV="development"
