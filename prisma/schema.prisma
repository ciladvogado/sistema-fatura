generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum InvoiceStatus {
  draft
  issued
  sent
  partially_paid
  paid
  overdue
  cancelled
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
  reversed
}

enum PaymentMethod {
  bank_transfer
  credit_card
  debit_card
  pix
  check
  cash
  other
}

enum ClientStatus {
  active
  inactive
  suspended
}

enum UserRole {
  ADMIN
  USER_PADRAO
}

enum AuditAction {
  login
  logout
  create
  update
  delete
  status_change
  payment_recorded
}

// ============================================
// MODELS
// ============================================

model Office {
  id                    Int      @id @default(autoincrement())
  name                  String   @unique
  cnpj                  String?  @unique
  phone                 String?
  email                 String   @unique

  addressStreet         String?
  addressNumber         String?
  addressComplement     String?
  addressCity           String?
  addressState          String?
  addressZip            String?
  addressCountry        String?  @default("Brazil")

  bankAccounts          BankAccount[]
  serviceProviders      ServiceProvider[]
  clients               Client[]
  invoices              Invoice[]
  users                 User[]
  auditLogs             AuditLog[]

  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isActive])
  @@index([cnpj])
  @@map("offices")
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  name                  String
  password              String
  role                  UserRole @default(USER_PADRAO)
  officeId              Int
  office                Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)

  resetToken            String?  @unique
  resetExpires          DateTime?

  auditLogs             AuditLog[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([officeId])
  @@index([email])
  @@map("users")
}

model BankAccount {
  id                    Int      @id @default(autoincrement())
  officeId              Int
  office                Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)

  bankName              String
  bankCode              String
  agencyNumber          String
  accountNumber         String
  accountType           String?
  accountHolder         String

  pixKey                String?  @unique
  pixKeyType            String?

  payments              Payment[]

  isActive              Boolean  @default(true)
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([officeId])
  @@index([isActive])
  @@map("bank_accounts")
}

model ServiceProvider {
  id                    Int      @id @default(autoincrement())
  officeId              Int
  office                Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)

  name                  String
  cnpjCpf               String
  email                 String?
  phone                 String?
  website               String?

  addressStreet         String?
  addressNumber         String?
  addressComplement     String?
  addressCity           String?
  addressState          String?
  addressZip            String?

  services              Service[]
  payments              Payment[]
  invoices              Invoice[]

  paymentTermsDays      Int      @default(30)
  defaultDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([officeId, cnpjCpf])
  @@index([officeId])
  @@index([isActive])
  @@map("service_providers")
}

model Service {
  id                    Int      @id @default(autoincrement())
  serviceProviderId     Int
  serviceProvider       ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)

  name                  String
  description           String?
  serviceCode           String?

  basePrice             Decimal  @db.Decimal(12, 2)
  unitType              String?
  containsQuantity      Boolean  @default(true)

  invoiceItems          InvoiceItem[]

  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([serviceProviderId, serviceCode])
  @@index([serviceProviderId])
  @@map("services")
}

model Client {
  id                    Int      @id @default(autoincrement())
  officeId              Int
  office                Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)

  name                  String
  cnpjCpf               String
  email                 String
  phone                 String?
  website               String?

  billingStreet         String?
  billingNumber         String?
  billingComplement     String?
  billingCity           String?
  billingState          String?
  billingZip            String?

  shippingStreet        String?
  shippingNumber        String?
  shippingComplement    String?
  shippingCity          String?
  shippingState         String?
  shippingZip           String?

  invoices              Invoice[]

  paymentTermsDays      Int      @default(30)
  creditLimit           Decimal? @db.Decimal(15, 2)
  isCreditAccount       Boolean  @default(false)

  status                ClientStatus @default(active)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([officeId, cnpjCpf])
  @@index([officeId])
  @@index([isActive])
  @@map("clients")
}

model Invoice {
  id                    Int      @id @default(autoincrement())
  officeId              Int
  office                Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  clientId              Int
  client                Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceProviderId     Int
  serviceProvider       ServiceProvider @relation(fields: [serviceProviderId], references: [id])

  invoiceNumber         String
  referenceNumber       String?
  competencyMonth       Int
  competencyYear        Int

  issueDate             DateTime @default(now())
  dueDate               DateTime
  sentDate              DateTime?
  viewedDate            DateTime?

  subtotal              Decimal  @default(0) @db.Decimal(15, 2)
  discountAmount        Decimal  @default(0) @db.Decimal(15, 2)
  discountPercent       Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount             Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount           Decimal  @db.Decimal(15, 2)

  paidAmount            Decimal  @default(0) @db.Decimal(15, 2)
  remainingAmount       Decimal  @db.Decimal(15, 2)

  items                 InvoiceItem[]
  paymentAllocations    PaymentInvoice[]

  status                InvoiceStatus @default(draft)
  notes                 String?
  internalNotes         String?
  externalId            String?
  isLocked              Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([officeId, invoiceNumber])
  @@unique([clientId, competencyMonth, competencyYear, serviceProviderId])
  @@index([officeId])
  @@index([clientId])
  @@index([status])
  @@index([issueDate(sort: Desc)])
  @@map("invoices")
}

model InvoiceItem {
  id                    Int      @id @default(autoincrement())
  invoiceId             Int
  invoice               Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId             Int?
  service               Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  description           String
  itemCode              String?

  quantity              Decimal  @db.Decimal(12, 4)
  unitPrice             Decimal  @db.Decimal(12, 2)
  lineTotal             Decimal  @db.Decimal(15, 2)

  taxPercent            Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount             Decimal  @db.Decimal(12, 2)

  lineOrder             Int      @default(1)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([invoiceId])
  @@index([serviceId])
  @@map("invoice_items")
}

model Payment {
  id                    Int      @id @default(autoincrement())
  serviceProviderId     Int
  serviceProvider       ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  bankAccountId         Int?
  bankAccount           BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  paymentReference      String   @unique
  externalTransactionId String?

  amount                Decimal  @db.Decimal(15, 2)
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus @default(pending)

  paymentDate           DateTime
  processedDate         DateTime?
  clearedDate           DateTime?

  invoiceAllocations    PaymentInvoice[]

  notes                 String?
  receiptNumber         String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([serviceProviderId])
  @@index([bankAccountId])
  @@index([paymentStatus])
  @@index([paymentDate(sort: Desc)])
  @@map("payments")
}

model PaymentInvoice {
  id                    Int      @id @default(autoincrement())
  paymentId             Int
  payment               Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId             Int
  invoice               Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  allocatedAmount       Decimal  @db.Decimal(15, 2)

  createdAt             DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_invoices")
}

model AuditLog {
  id                    BigInt   @id @default(autoincrement())
  officeId              Int
  office                Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action                AuditAction
  entityType            String?
  entityId              Int?

  description           String
  ipAddress             String?
  userAgent             String?

  createdAt             DateTime @default(now())

  @@index([officeId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}
